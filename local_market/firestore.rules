rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Users collection rules
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    // 2. Physical Shops collection rules
    match /shops/{shopId} {
      // Public read access for local buyers discovering nearby shops
      allow read: if true;
      
      // Only authenticated sellers can create or edit their physical shop profile
      allow create: if isAuthenticated() && request.resource.data.owner_id == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.owner_id == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.owner_id == request.auth.uid;
    }

    // 3. Products collection rules
    match /products/{productId} {
      // Public read access for local product discovery
      allow read: if true;
      
      // Only authenticated sellers can manage product catalog items
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }

    // 4. Orders collection rules
    match /orders/{orderId} {
      // Buyers can read their own placed orders
      // Sellers can read incoming orders for their shop
      allow read: if isAuthenticated() && 
        (resource.data.buyer_id == request.auth.uid || resource.data.shop_owner_id == request.auth.uid);
      
      // Authenticated buyers can place new orders
      allow create: if isAuthenticated() && request.resource.data.buyer_id == request.auth.uid;
      
      // Sellers can update order status; buyers cannot modify existing order details
      allow update: if isAuthenticated() && 
        (resource.data.buyer_id == request.auth.uid || resource.data.shop_owner_id == request.auth.uid);
        
      allow delete: if false;
    }
  }
}
