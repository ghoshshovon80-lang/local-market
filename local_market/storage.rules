rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Product original image storage rules
    match /products/{shopId}/{fileName} {
      // Public read access for local buyers viewing product photos
      allow read: if true;
      
      // Authenticated sellers can upload product photos (Max size: 5MB, image only)
      allow write: if request.auth != null 
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
